{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MQTT Device Simulator",
  "version": "0.1.0",
  "identifier": "dev.mqttsimulator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MQTT Device Simulator",
        "width": 1500,
        "height": 980,
        "minWidth": 1240,
        "minHeight": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
